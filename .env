# Payment Gateway server .env

# Server port (your code reads lowercase "port")
port=3000

# UPI payee details used to build the UPI intent/QR
UPI=swags@freecharge
Name=Magical Developer

# How often (in seconds) to poll Freecharge for the comment
FETCH_PER_SECONDS=1

# CORS: where your client server is hosted
CLIENT_URL=http://localhost:3001

# If the gateway page is hit with a missing/invalid comment
# or the client server doesn't recognize the comment, redirect here
REDIRECT_URL=http://localhost:3001

# Number of worker threads for QR generation (CPU-bound work)
# Increase on multi-core machines if many users start payments at once
QR_WORKERS=2
